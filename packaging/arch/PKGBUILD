# Maintainer: 12Viskas12
pkgname=loghunt
pkgver=0.1.0
pkgrel=1
pkgdesc='Finds brute force, scans and web attacks in SSH and web server logs, with alerts'
arch=('any')
url='https://github.com/12Viskas12/loghunt'
license=('MIT')
depends=('python')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
optdepends=('libnotify: desktop notifications')

prepare() {
  local root="$startdir/../.."
  cp -r "$root/src" "$root/pyproject.toml" "$root/README.md" "$root/LICENSE" "$srcdir/"
  cp "$root/packaging/loghunt.service" "$srcdir/"
}

build() {
  cd "$srcdir"
  python -m build --wheel --no-isolation
}

package() {
  cd "$srcdir"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 loghunt.service "$pkgdir/usr/lib/systemd/user/loghunt.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
